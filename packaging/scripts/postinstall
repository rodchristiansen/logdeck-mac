#!/bin/bash
#
# LogDeck postinstall script
# Runs after the .pkg is installed by the system
#

# Ensure CLI binary is executable
if [[ -f /usr/local/bin/logdeck ]]; then
    chmod 755 /usr/local/bin/logdeck
fi

# Ensure app bundle binary is executable
APP_BINARY="/Applications/Utilities/LogDeck.app/Contents/MacOS/LogDeck"
if [[ -f "$APP_BINARY" ]]; then
    chmod 755 "$APP_BINARY"
fi

exit 0
