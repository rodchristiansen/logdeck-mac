# LogDeck Build Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ============================================================================
# CODE SIGNING
# ============================================================================

# Developer ID Application certificate (signs app bundle and CLI binary)
# Find yours: security find-identity -v -p codesigning | grep "Developer ID"
SIGNING_IDENTITY_APP="Developer ID Application: Your Organization (TEAMID)"

# Developer ID Installer certificate (signs the .pkg)
# Find yours: security find-identity -v -p basic | grep "Developer ID Installer"
SIGNING_IDENTITY_PKG="Developer ID Installer: Your Organization (TEAMID)"

# ============================================================================
# NOTARIZATION
# ============================================================================

# Notarytool keychain profile name
# Create with:
#   xcrun notarytool store-credentials "PROFILE_NAME" \
#     --apple-id "you@example.com" \
#     --team-id "TEAMID" \
#     --password "app-specific-password"
NOTARIZATION_PROFILE="notarization_credentials"

# Apple Developer Team ID
NOTARIZATION_TEAM_ID="TEAMID"

# ============================================================================
# VERSION (optional)
# ============================================================================

# Override the auto-generated YYYY.MM.DD.HHMM version
# VERSION=1.0.0
