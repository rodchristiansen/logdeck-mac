# LogDeck build configuration
# Copy this file to .env and fill in your values. Never commit .env.

# Developer ID Application certificate (signs the app and the logdeck tool)
# security find-identity -v -p codesigning | grep "Developer ID"
SIGNING_IDENTITY_APP=Developer ID Application: Your Name (TEAMID)

# Developer ID Installer certificate (signs the .pkg)
SIGNING_IDENTITY_PKG=Developer ID Installer: Your Name (TEAMID)

# notarytool keychain profile, created with xcrun notarytool store-credentials
NOTARIZATION_PROFILE=notarization_credentials
