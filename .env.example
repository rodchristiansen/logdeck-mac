# LogDeck Build Configuration
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
#
# To create a notarytool profile:
#   xcrun notarytool store-credentials "notarization_credentials" \
#     --apple-id "your@email.com" \
#     --team-id "TEAMID0000" \
#     --password "app-specific-password"

# ---------------------------------------------------------------------------
# Code Signing
# ---------------------------------------------------------------------------

# Developer ID Application certificate (for app bundle and CLI binary)
# Find yours with: security find-identity -v -p codesigning | grep "Developer ID"
APP_SIGNING_CERT=Developer ID Application: Example Organisation (TEAMID0000)

# ---------------------------------------------------------------------------
# Notarization
# ---------------------------------------------------------------------------

# Notarytool keychain profile name (created with xcrun notarytool store-credentials)
NOTARY_PROFILE=notarization_credentials

# Apple Developer Team ID
TEAM_ID=TEAMID0000

# ---------------------------------------------------------------------------
# Output
# ---------------------------------------------------------------------------

# Override the auto-generated YYYY.MM.DD.HHMM version if desired
# VERSION=1.0.0
